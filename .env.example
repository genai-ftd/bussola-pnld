# Credenciais da API do Issuu (conta editoraftd).
# Copie este arquivo para .env e preencha. .env está no .gitignore.
# Usadas SOMENTE para ler metadados (GET /v2/publications) e montar os links
# "Abrir conteúdo" — nunca para extrair conteúdo de página.
ISSUU_TOKEN=
ISSUU_CLIENT_ID=
ISSUU_CLIENT_SECRET=

# Modelo de embeddings (multilíngue, roda local, sem chamada a LLM)
MODELO_EMBEDDINGS=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# API
BUSSOLA_API_HOST=127.0.0.1
BUSSOLA_API_PORT=8000

# Registro das sessões de teste numa planilha (opcional).
# URL do Apps Script publicado como web app — ver "Registro das sessões" no README.
# Vazio = a página só grava no navegador do testador.
BUSSOLA_LOG_URL=
